<Window x:Class="AutoPrint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AutoPrint.ViewModels"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Closing="Window_Closing"
        Title="AutoPrint — принт-сервер Mulex P80"
        Height="820" Width="1320" MinHeight="640" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:StatusToBrushConverter x:Key="StatusToBrush"/>
        <vm:InverseBoolConverter x:Key="InverseBool"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Значок в системном трее: статусы в подсказке/меню, закрытие и открытие окна -->
        <tb:TaskbarIcon x:Name="Tray" Grid.Row="0"
                        ToolTipText="{Binding TrayStatus}"
                        TrayMouseDoubleClick="Tray_ShowWindow">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Открыть AutoPrint" FontWeight="SemiBold" Click="Tray_ShowWindow"/>
                    <Separator/>
                    <MenuItem Header="{Binding TrayStatus}" IsEnabled="False"/>
                    <Separator/>
                    <MenuItem Header="Выход (остановить сервер)" Click="Tray_Exit"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- ===== Шапка ===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,14">
            <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentBrush}"
                    VerticalAlignment="Center">
                <TextBlock Text="🖨" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="AutoPrint" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Бесперебойный принт-сервер термопринтера Mulex P80mm"
                           FontSize="12" Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
            <!-- Индикатор статуса сервера -->
            <Border Margin="24,0,0,0" Padding="12,6" CornerRadius="14" VerticalAlignment="Center"
                    Background="#11000000">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{Binding ServerStatusBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Сервер: " Margin="8,0,0,0" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="{Binding ServerStatus}" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ===== Три панели ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="430"/>
            </Grid.ColumnDefinitions>

            <!-- ================= ЛЕВАЯ: Управление / Драйверы / Тесты ================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0"
                          PreviewMouseWheel="Column_PreviewMouseWheel">
                <StackPanel>

                    <!-- ДИАГНОСТИКА И АВТОПОДКЛЮЧЕНИЕ -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Подключение и диагностика"/>

                            <Border Background="#0A000000" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Активное подключение:" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding ActiveTargetLabel}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource AccentButton}"
                                    Content="{Binding SetupButtonLabel}"
                                    Command="{Binding FullSetupCommand}"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Находит USB-принтер (ставит драйвер при необходимости) и печатает тестовый чек."/>

                            <!-- Результаты диагностики -->
                            <Border Background="#0D000000" CornerRadius="6" Padding="6" Margin="0,10,0,0"
                                    MaxHeight="240" MinHeight="30">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding DiagnosticSteps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontWeight="Bold"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextPrimary}"/>
                                                        <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextSecondary}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Драйвер принтера"/>

                            <TextBlock Style="{StaticResource Caption}" Text="Целевой принтер"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding Printers}"
                                          SelectedItem="{Binding SelectedPrinter}"/>
                                <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource FluentButton}"
                                        Content="⟳" ToolTip="Обновить список принтеров"
                                        Command="{Binding RefreshPrintersCommand}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="RAW-печать напрямую в спулер (ESC/POS)."/>

                            <Separator Margin="0,10" Opacity="0.3"/>

                            <TextBlock Style="{StaticResource Caption}" Text="Установка драйвера (нужны права администратора)"/>
                            <ComboBox ItemsSource="{Binding Drivers}"
                                      SelectedItem="{Binding SelectedDriver}"/>
                            <Button Style="{StaticResource FluentButton}" Margin="0,8,0,0"
                                    Content="⚙  Установить драйвер"
                                    Command="{Binding InstallDriverCommand}"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Запустит инсталлятор с запросом UAC. После установки список принтеров обновится."/>

                            <CheckBox Margin="0,8,0,0" Content="После установки задать имя принтеру"
                                      IsChecked="{Binding AutoNamePrinter}"
                                      Foreground="{StaticResource TextPrimary}"/>
                            <TextBox Margin="0,6,0,0" Text="{Binding PrinterFriendlyName, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding AutoNamePrinter}"
                                     ToolTip="Имя, под которым принтер появится в Windows (например Mulex P80mm)"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Установленный чековый принтер будет переименован в это имя (нужны права администратора)."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Автозапуск"/>
                            <CheckBox Content="Запускать при включении компьютера"
                                      IsChecked="{Binding AutoStartWithWindows}"
                                      Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Text="Через реестр (HKCU), без ярлыка в папке автозагрузки — переживает переустановку/обновление. При автозапуске окно сразу сворачивается в трей, принт-сервер работает в фоне."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Сеть и порт"/>
                            <TextBlock Style="{StaticResource Caption}" Text="TCP/HTTP порт службы"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource FluentButton}"
                                        Content="⟳ Перезапустить" Command="{Binding RestartServerCommand}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Освобождает старый порт и слушает новый без рестарта приложения."/>
                            <Border Background="#0A000000" CornerRadius="6" Padding="10" Margin="0,6,0,0">
                                <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Text="POST http://localhost:{порт}/print&#10;Content-Type: application/json | text/html | image/png"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Тестирование"/>
                            <Button Style="{StaticResource AccentButton}"
                                    Content="🧾  Напечатать системный тест"
                                    Command="{Binding PrintSystemTestCommand}"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Печатает тестовый чек с проверкой Auto-Cut."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Журнал перехвата"/>
                            <Border Background="#0D000000" CornerRadius="6" Padding="8" Height="150">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding Log}" FontFamily="Consolas" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ОБНОВЛЕНИЯ (GitHub Releases) -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitle}"
                                           Text="Обновления"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentVersionLabel}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </DockPanel>

                            <Button Style="{StaticResource FluentButton}" Margin="0,8,0,0"
                                    Content="🔄  Проверить обновления"
                                    Command="{Binding CheckUpdateCommand}"/>

                            <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       FontSize="12" Foreground="{StaticResource TextPrimary}"/>

                            <!-- Заметки к релизу -->
                            <Border Background="#0D000000" CornerRadius="6" Padding="8" Margin="0,6,0,0"
                                    MaxHeight="110"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding UpdateNotes}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondary}"/>
                                </ScrollViewer>
                            </Border>

                            <Button Style="{StaticResource AccentButton}" Margin="0,8,0,0"
                                    Content="⬇  Скачать и установить"
                                    Command="{Binding InstallUpdateCommand}"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"/>

                            <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                         Value="{Binding UpdateProgress, Mode=OneWay}"
                                         Visibility="{Binding ShowUpdateProgress, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ================= ЦЕНТР: Форматы и геометрия ================= -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0"
                          PreviewMouseWheel="Column_PreviewMouseWheel">
                <StackPanel>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Формат входных данных"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedRadio}" Margin="0,0,8,0"
                                             Content="JSON (вектор)" IsChecked="{Binding IsJsonFormat}"/>
                                <RadioButton Style="{StaticResource SegmentedRadio}" Margin="0,0,8,0"
                                             Content="HTML (вёрстка)" IsChecked="{Binding IsHtmlFormat}"/>
                                <RadioButton Style="{StaticResource SegmentedRadio}"
                                             Content="PNG/JPEG (растр)" IsChecked="{Binding IsImageFormat}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitle}"
                                           Text="Геометрия ленты и шрифты"/>
                                <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                        Style="{StaticResource AccentButton}" Padding="12,6"
                                        Content="💾 Сохранить настройки" Command="{Binding SaveSettingsCommand}"
                                        ToolTip="Сохранить геометрию, шрифты и настройки QR (переживут перезапуск)"/>
                            </DockPanel>

                            <DockPanel Margin="0,4,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="Ширина ленты" Width="150"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TapeWidthLabel}" Width="130"
                                           TextAlignment="Right" Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                                <Slider Minimum="58" Maximum="80" TickFrequency="1"
                                        Value="{Binding TapeWidthMm}"/>
                            </DockPanel>

                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="Боковые отступы" Width="150"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SideMarginsPx, StringFormat={}{0:0} px}"
                                           Width="130" TextAlignment="Right"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <Slider Minimum="0" Maximum="40" TickFrequency="1" Value="{Binding SideMarginsPx}"/>
                            </DockPanel>

                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="Шрифт шапки" Width="150"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding HeaderFontPt, StringFormat={}{0:0} pt}"
                                           Width="130" TextAlignment="Right"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <Slider Minimum="5" Maximum="18" TickFrequency="1" Value="{Binding HeaderFontPt}"/>
                            </DockPanel>

                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="Шрифт содержимого" Width="150"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding BodyFontPt, StringFormat={}{0:0} pt}"
                                           Width="130" TextAlignment="Right"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <Slider Minimum="5" Maximum="18" TickFrequency="1" Value="{Binding BodyFontPt}"/>
                            </DockPanel>

                            <Separator Margin="0,12,0,8" Opacity="0.3"/>

                            <TextBlock Style="{StaticResource Caption}" Text="Режим форматирования"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedRadio}" Margin="0,0,8,0"
                                             Content="Графика (форматирует ПК)" IsChecked="{Binding IsGraphicsMode}"/>
                                <RadioButton Style="{StaticResource SegmentedRadio}"
                                             Content="Текст ESC/POS (принтер)"
                                             IsChecked="{Binding IsGraphicsMode, Converter={StaticResource InverseBool}}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding RenderModeLabel}"/>

                            <Separator Margin="0,12,0,8" Opacity="0.3"/>

                            <!-- QR-код ссылки проверки чека (checkUrl) -->
                            <CheckBox Content="Печатать QR-код ссылки проверки чека внизу по центру"
                                      IsChecked="{Binding QrEnabled}"
                                      Foreground="{StaticResource TextPrimary}"/>
                            <DockPanel Margin="0,10,0,0"
                                       IsEnabled="{Binding QrEnabled}">
                                <TextBlock DockPanel.Dock="Left" Text="Размер QR" Width="150"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding QrSizeLabel}" Width="130"
                                           TextAlignment="Right" Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                                <Slider Minimum="10" Maximum="40" TickFrequency="1" Value="{Binding QrSizeMm}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="QR формируется из поля checkUrl входящего JSON. Размер сохраняется вместе с настройками."/>

                            <Separator Margin="0,12,0,8" Opacity="0.3"/>

                            <!-- Настройки принтера: вертикальные отступы, отрез, ящик -->
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Настройки принтера"/>

                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="Отступ сверху" Width="150"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TopMarginLines, StringFormat={}{0:0} стр}"
                                           Width="130" TextAlignment="Right"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <Slider Minimum="0" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding TopMarginLines}"/>
                            </DockPanel>

                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="Отступ снизу" Width="150"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding BottomMarginLines, StringFormat={}{0:0} стр}"
                                           Width="130" TextAlignment="Right"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <Slider Minimum="0" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding BottomMarginLines}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Отступ снизу также протягивает ленту до ножа перед отрезом."/>

                            <CheckBox Margin="0,10,0,0" Content="Автоматический отрез ленты после чека"
                                      IsChecked="{Binding AutoCut}"
                                      Foreground="{StaticResource TextPrimary}"/>
                            <CheckBox Margin="0,8,0,0" Content="Полный отрез (вместо частичного)"
                                      IsChecked="{Binding FullCut}" IsEnabled="{Binding AutoCut}"
                                      Foreground="{StaticResource TextPrimary}"/>
                            <CheckBox Margin="0,8,0,0" Content="Открывать денежный ящик после печати"
                                      IsChecked="{Binding OpenDrawer}"
                                      Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                    </Border>

                    <!-- Тип чека -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding IsJsonFormat, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Тип чека"/>
                            <ComboBox ItemsSource="{Binding DocTypes}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedDocType}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Style="{StaticResource AccentButton}" Padding="12,6" Margin="0,0,8,0"
                                        Content="🖨 Тест печать" Command="{Binding TestPrintTypeCommand}"/>
                                <Button Style="{StaticResource FluentButton}" Padding="12,6" Margin="0,0,8,0"
                                        Content="💾 Сохранить шаблон" Command="{Binding SaveTemplateCommand}"/>
                                <Button Style="{StaticResource FluentButton}" Padding="12,6"
                                        Content="↺ Сбросить" Command="{Binding ResetTemplateCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Конструктор разметки чека -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding IsJsonFormat, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitle}"
                                           Text="Конструктор чека"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource FluentButton}" Padding="8,4" Margin="0,0,6,0"
                                            Content="+ Текст" Command="{Binding AddTextLineCommand}"/>
                                    <Button Style="{StaticResource FluentButton}" Padding="8,4" Margin="0,0,6,0"
                                            Content="+ 2 колонки" Command="{Binding AddTwoColLineCommand}"/>
                                    <Button Style="{StaticResource FluentButton}" Padding="8,4"
                                            Content="+ Отступ" Command="{Binding AddSpacerLineCommand}"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Тяните строки за ⠿ для порядка. В тексте пишите статичный текст и параметр {{имя}} — туда сядет значение из JSON фронта (напр. {{cashier}}, {{total}})."/>

                            <ListBox x:Name="LinesList" ItemsSource="{Binding TemplateLines}"
                                     AllowDrop="True" Drop="LinesList_Drop" DragOver="LinesList_DragOver"
                                     Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MaxHeight="420">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,2"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0D000000" CornerRadius="6" Padding="8,6">
                                            <StackPanel>
                                                <!-- строка управления -->
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="⠿" FontSize="16"
                                                               Margin="0,0,8,0" Cursor="SizeAll"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               PreviewMouseLeftButtonDown="Grip_PreviewMouseLeftButtonDown"
                                                               ToolTip="Перетащите для изменения порядка"/>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Content="▲" Padding="6,2" Style="{StaticResource FluentButton}"
                                                                Command="{Binding DataContext.MoveLineUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="▼" Padding="6,2" Margin="4,0,0,0" Style="{StaticResource FluentButton}"
                                                                Command="{Binding DataContext.MoveLineDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="✕" Padding="6,2" Margin="4,0,0,0" Style="{StaticResource FluentButton}"
                                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondary}"/>
                                                </DockPanel>

                                                <!-- настройки формата -->
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                            Visibility="{Binding HasFormatting, Converter={StaticResource BoolToVis}}">
                                                    <ComboBox Width="96" SelectedIndex="{Binding AlignIndex}" Margin="0,0,8,0">
                                                        <ComboBoxItem Content="Слева"/>
                                                        <ComboBoxItem Content="Центр"/>
                                                        <ComboBoxItem Content="Справа"/>
                                                    </ComboBox>
                                                    <CheckBox Content="Шапка" IsChecked="{Binding IsHeaderFont}"
                                                              VerticalAlignment="Center" Margin="0,0,10,0"
                                                              ToolTip="Шрифт шапки (иначе — шрифт содержимого)"/>
                                                    <CheckBox Content="Жирный" IsChecked="{Binding Bold}"
                                                              VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- редактор текста: Text -->
                                                <TextBox Margin="0,6,0,0" FontFamily="Consolas"
                                                         Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"/>

                                                <!-- редактор: TwoCol -->
                                                <Grid Margin="0,6,0,0"
                                                      Visibility="{Binding IsTwoCol, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Margin="0,0,4,0" FontFamily="Consolas"
                                                             Text="{Binding Left, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Слева (метка)"/>
                                                    <TextBox Grid.Column="1" Margin="4,0,0,0" FontFamily="Consolas"
                                                             Text="{Binding Right, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Справа (значение/сумма)"/>
                                                </Grid>

                                                <!-- редактор: Items -->
                                                <StackPanel Margin="0,6,0,0"
                                                            Visibility="{Binding IsItems, Converter={StaticResource BoolToVis}}">
                                                    <TextBox FontFamily="Consolas" Margin="0,0,0,4"
                                                             Text="{Binding ItemLine1, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Строка позиции 1"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Margin="0,0,4,0" FontFamily="Consolas"
                                                                 Text="{Binding ItemLine2Left, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBox Grid.Column="1" Margin="4,0,0,0" FontFamily="Consolas"
                                                                 Text="{Binding ItemLine2Right, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Данные с фронта (JSON) -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding IsJsonFormat, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Данные с фронта (JSON)"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Пример входных значений для предпросмотра. Ключи отсюда подставляются в {{параметры}} шаблона."/>
                            <TextBox Text="{Binding JsonInput, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="180"
                                     FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>

                    <!-- Редактор данных: HTML -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding IsHtmlFormat, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="HTML-код чека"/>
                            <TextBox Text="{Binding HtmlInput, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="220"
                                     FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
                            <Button Style="{StaticResource FluentButton}" Margin="0,8,0,0"
                                    HorizontalAlignment="Left" Content="Обновить предпросмотр"
                                    Command="{Binding RefreshPreviewCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Редактор данных: Image -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding IsImageFormat, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Растровое изображение"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ImagePath}" IsReadOnly="True"/>
                                <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource FluentButton}"
                                        Content="Выбрать…" Command="{Binding LoadImageCommand}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Картинка конвертируется в 1-битный ЧБ (Floyd–Steinberg) на лету."/>
                        </StackPanel>
                    </Border>

                    <!-- ================= ОЧЕРЕДЬ ПЕЧАТИ ================= -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitle}"
                                           Text="Очередь печати"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource FluentButton}" Padding="10,5" Margin="0,0,6,0"
                                            Content="{Binding QueuePauseLabel}"
                                            Command="{Binding PauseResumeQueueCommand}"/>
                                    <Button Style="{StaticResource FluentButton}" Padding="10,5"
                                            Content="🧹 Очистить"
                                            Command="{Binding ClearQueueCommand}"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Background="#0D000000" CornerRadius="6" Padding="4" Margin="0,4,0,0"
                                    MinHeight="60" MaxHeight="260">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Queue.Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Клик по строке открывает просмотр чека: кассиру нужно
                                                     увидеть, что именно за чек, прежде чем печатать повторно. -->
                                                <Border Background="{StaticResource CardBackground}" CornerRadius="6"
                                                        Padding="10,7" Margin="3" Cursor="Hand"
                                                        ToolTip="Открыть чек — посмотреть и напечатать повторно"
                                                        MouseLeftButtonUp="QueueItem_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding StatusIcon}"
                                                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <Border Background="#22FF9800" CornerRadius="4" Padding="5,1"
                                                                    HorizontalAlignment="Left" Margin="0,0,0,2"
                                                                    Visibility="{Binding IsSpecial, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                                                           FontWeight="SemiBold" Foreground="#FF9800"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{StaticResource TextPrimary}"/>
                                                            <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                                                       Foreground="{StaticResource TextSecondary}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <Button Style="{StaticResource FluentButton}" Padding="8,4"
                                                                    Content="👁" ToolTip="Посмотреть чек"
                                                                    Command="{Binding DataContext.ViewJobCommand,
                                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Style="{StaticResource FluentButton}" Padding="8,4" Margin="6,0,0,0"
                                                                    Content="↻" ToolTip="Повторить"
                                                                    Command="{Binding DataContext.RetryJobCommand,
                                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding CanReprint, Converter={StaticResource BoolToVis}}"/>
                                                            <Button Style="{StaticResource FluentButton}" Padding="8,4" Margin="6,0,0,0"
                                                                    Content="✕" ToolTip="Отменить"
                                                                    Command="{Binding DataContext.CancelJobCommand,
                                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Задания печатаются по одному. При сбое — до 3 автоповторов; можно ставить на паузу, отменять и повторять вручную. Клик по чеку — посмотреть его и напечатать заново."/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ================= ПРАВАЯ: Live Preview ================= -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                               Text="Live Preview — рулон чека"/>
                    <Border DockPanel.Dock="Bottom" Background="#0A000000" CornerRadius="6"
                            Padding="10" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Notification}" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimary}" FontSize="12"/>
                    </Border>

                    <!-- Тёмный "стол" под лентой, лента центрируется -->
                    <Border Background="#FF2B2B2B" CornerRadius="8" Padding="0,18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <!-- Сама бумажная лента: ширина = TapeWidthInPixels (мм->px @96DPI) -->
                            <Border Background="White" HorizontalAlignment="Center"
                                    Width="{Binding TapeWidthInPixels}"
                                    Padding="{Binding PreviewPadding}"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.4" Color="Black"/>
                                </Border.Effect>
                                <Grid>
                                    <!-- Текстовый предпросмотр (JSON) -->
                                    <TextBlock Text="{Binding PreviewText}"
                                               Visibility="{Binding ShowTextPreview, Converter={StaticResource BoolToVis}}"
                                               FontFamily="Consolas"
                                               FontSize="{Binding PreviewFontSize}"
                                               Foreground="Black" TextWrapping="NoWrap"/>
                                    <!-- Растровый предпросмотр (HTML / Image) -->
                                    <Image Source="{Binding PreviewImage}"
                                           Visibility="{Binding ShowImagePreview, Converter={StaticResource BoolToVis}}"
                                           Stretch="Uniform" SnapsToDevicePixels="True"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Grid>
                            </Border>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>

        </Grid>
    </Grid>
</Window>
