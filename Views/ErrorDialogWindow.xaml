<Window x:Class="AutoPrint.Views.ErrorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoPrint" Height="360" Width="440"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="⚠" FontSize="26" Foreground="{StaticResource DangerBrush}" Margin="0,0,10,0"/>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="MessageText" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14" FontSize="13"/>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" Padding="14">
            <StackPanel x:Name="StepsPanel"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="RetryButton" Content="↻ Повторить" Style="{StaticResource FluentButton}"
                    Padding="14,8" Margin="0,0,8,0" Click="Retry_Click" Visibility="Collapsed"/>
            <Button Content="Понятно" Style="{StaticResource AccentButton}" Padding="18,8"
                    Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
